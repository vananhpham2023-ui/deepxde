--data estimation/datasets/force_estimation_train.csv \
--sample-size 10000 \
--seed 42 \
--data-seed 42 \
--norm-cache normalizer_stats.pkl \
--dataset-cache dataset_cache_task12.pkl \
"

TRAIN_ARGS="\
--adam-iters 10000 \
--early-patience 0 \
--grad-monitor \
"
```

