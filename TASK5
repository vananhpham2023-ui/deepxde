**Task 2.2 实现示例（正确做法：常量不进网络；推力为动态变量）**：

```python
# 方案A: 使用 DeepXDE 的 auxiliary_var 机制（推荐）
from force_estimation_utils import ConstantManager

# 1. 定义网络输入（13维: 12 动态 + thrust）
NETWORK_INPUT_COLUMNS = [
    'accQ_x', 'accQ_y', 'accQ_z',      # 四旋翼加速度 (3)
    'accL_x', 'accL_y', 'accL_z',      # 负载加速度 (3)
    'rho_x', 'rho_y', 'rho_z',         # 连接向量 (3)
    'ez_world_x', 'ez_world_y', 'ez_world_z',  # 世界坐标系 z 轴 (3)
    'thrust',                                    # 推力为动态控制量 (1)
]  # 总计: 13 维

# 2. 初始化常量管理器（不包含 thrust）
const_mgr = ConstantManager(df, constant_columns=['m_Q', 'm_L', 'g'])

# 3. 自定义采样函数（返回动态变量 + 常量，但分开存储）
class MixedSampler:
    def __init__(self, geom, const_mgr, df):
        self.geom = geom
        self.const_mgr = const_mgr
        self.df = df

    def sample_domain(self, num_points):
        """采样域内点"""
        # 几何采样动态变量（12维，不含 thrust）
        dynamic_points_12 = self.geom.random_points(num_points)

        # 从数据集中随机抽取 thrust（动态控制量，1维）
        thrust_vals = (
            self.df['thrust']
            .sample(n=num_points, replace=True)
            .to_numpy()
            .reshape(-1, 1)
        )

        # 组合形成 13 维网络输入
        dynamic_points = np.concatenate([dynamic_points_12, thrust_vals], axis=1)

        # 随机选择对应的批次常量（3维或 4 维，取决于是否包含 l_length）
        batch_indices = np.random.choice(len(self.df), num_points)
        constants = self.const_mgr.get_batch_constants(batch_indices)

        # 返回 (动态变量, 常量) 元组
        return dynamic_points, constants

# 4. 修改 PDE 残差函数，接收常量作为独立参数
def build_force_estimation_residual_with_constants(normalizer):
    """
    构建支持外部常量的残差函数

    关键改动: x 包含 13 维动态变量（含 thrust），constants 单独传入（不含 thrust）
    """
    def residual(x, y, aux_vars):
        """
        Args:
            x: 网络输入（13维动态变量，含 thrust）
            y: 网络输出（6维力估计）
            aux_vars: 辅助变量（常量: m_Q, m_L, g[, l_length]）
        """
        # 反归一化动态变量（13维）
        x_denorm = normalizer.inverse_tensor(x)

        # 提取常量（不经过网络）
        # 注意：thrust 为动态量，来自 x
        m_Q = aux_vars[:, 0:1]
        m_L = aux_vars[:, 1:2]
        g = aux_vars[:, 2:3]

        # 提取动态变量
        acc_Q = x_denorm[:, 0:3]    # 形状: (batch, 3)
        acc_L = x_denorm[:, 3:6]
        rho = x_denorm[:, 6:9]
        ez_world = x_denorm[:, 9:12]
        thrust = x_denorm[:, 12:13]  # 动态推力（来自网络输入）

        # 提取网络预测的力（6维）
        f_Q = y[:, 0:3]
        f_L = y[:, 3:6]

        # 计算物理残差（使用常量）
        # r1: 力平衡
        r1 = f_Q + f_L - m_Q * acc_Q - m_L * acc_L - (m_Q + m_L) * g * ez_world

        # r2: 力矩平衡（使用动态 thrust）
        rho_cross_fQ = bkd.lib.cross(rho, f_Q)
        thrust_term = thrust * ez_world  # 使用动态输入 thrust
        r2 = rho_cross_fQ + m_Q * g * rho - m_Q * bkd.lib.cross(rho, acc_Q) - thrust_term

        # r3: 平行约束
        rho_norm = bkd.lib.norm(rho, axis=1, keepdims=True)
        r3 = bkd.lib.sum(f_L * rho, axis=1, keepdims=True) / rho_norm

        return bkd.lib.concatenate([r1, r2, r3], axis=1)

    return residual

# 5. 创建 DeepXDE 数据对象（使用 auxiliary_var_function）
sampler = MixedSampler(time_geom, const_mgr, df)

def auxiliary_var_function(x):
    """
    为每个输入点 x 提供对应的辅助变量（常量）
    """
    # 注意: 这里需要根据 x 的批次索引查找对应常量
    # DeepXDE 会自动调用此函数
    batch_size = x.shape[0]
    # 简化版: 返回平均常量（实际应维护索引映射）
    return np.tile(const_mgr.get_mean_constants(), (batch_size, 1))

data = dde.data.PDE(
    geom=time_geom,
    pde=build_force_estimation_residual_with_constants(normalizer),
    bcs=bcs,
    num_domain=10000,
    num_boundary=2000,
    auxiliary_var_function=auxiliary_var_function  # 关键: 仅提供常量（不含 thrust）
)

# 6. 网络定义（输入13维，输出6维）
net = dde.nn.FNN(
    layer_sizes=[13, 64, 64, 64, 6],  # 输入13维（动态变量 + thrust；不包含常量）
    activation="tanh",
    kernel_initializer="Glorot uniform"
)
```

**关键要点**：
1. ✅ 网络输入为**13维**（12 个动态变量 + thrust）
2. ✅ 常量通过 `auxiliary_var_function` 或自定义类传入
3. ✅ 常量在残差函数中使用，但**不参与反向传播到网络权重**
4. ✅ 实现了阶段一“网络输入维度调整为 13 维（含 thrust）”的目标
```

